# 卡博士 H5 本地环境示例
#
# 复制为 .env.local 后按需修改。不要提交真实密钥或生产地址。
# App 环境与 build identity 通常由 scripts/build-h5.mjs 根据构建目标注入；
# 本地 `npm run dev` 未填写时会从 Vite development mode 推导为 dev。

# preview/dev 默认 mock；test/prod 默认 api。
# `.env.local` 会被所有 Vite mode 加载，因此这里不要固定为 mock；
# 需要本地 dev 显式切 API 时再取消下一行注释。
# VITE_DATA_MODE=api

# OAuth 登录开发服务（当前约定 POST /api/oauth/login）。
# 真机联调时还需配置 VITE_BRIDGE_MODE=native；test/prod 使用各自环境的 API 地址。
VITE_API_BASE_URL=http://192.168.1.81:7002

# 上游卡包接口（仅本地联调；不要提交真实 token 或 salt）
VITE_CARD_API_BASE_URL=https://app.dev.9kbs.com
VITE_CARD_API_TOKEN=
VITE_CARD_API_SALT=

# disabled | mock | native
# H015 的真实 Native JSBridge 协议尚未提供，因此默认 disabled。
# test/prod 禁止 bridge mock。
VITE_BRIDGE_MODE=disabled

# 商城 iframe 目标：kbs_shop（kbs-shop.3cgroup.cn/h5）或 kbs_shop2（kbs-shop2.3cgroup.cn/h5）。
# 未填写时默认 kbs_shop；非法值会让构建失败 / 商城页显式报错，避免悄悄加载错误商城。
# VITE_MALL_TARGET=kbs_shop

# 通常不要手工设置以下变量；build-h5 会注入当前构建事实。
# VITE_APP_ENV=dev
# VITE_BUILD_SHA=local
# VITE_BUILD_ID=local
# VITE_SOURCE_BRANCH=local

# 正式洗头搭子邀请二维码公开站点；test/prod 请分别配置，缺失时显式失败
# VITE_BUDDY_PUBLIC_ORIGIN=https://test.dr-card-ui.pages.dev
