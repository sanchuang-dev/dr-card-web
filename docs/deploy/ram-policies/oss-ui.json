{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": "acs:oss:*:*:kbs-sdl",
      "Condition": {
        "StringLike": {
          "oss:Prefix": [
            "kbs-web/ui/",
            "kbs-web/ui/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject"
      ],
      "Resource": "acs:oss:*:*:kbs-sdl/kbs-web/ui/*"
    }
  ]
}
