{
  "name": "dr-card-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:5175": "npm run dev -- --port 5175",
    "dev:mock:5175": "npm run dev -- --mode preview --port 5175",
    "adb:reverse:5175": "adb reverse tcp:5175 tcp:5175",
    "dev:android:5175": "node scripts/dev-android.mjs",
    "lint": "node scripts/check-h5-hygiene.mjs && node scripts/check-fixture-query-debt.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:images": "node scripts/verify-image-assets.mjs",
    "build": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs auto",
    "build:dev": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs dev",
    "build:preview": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs preview",
    "build:test": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs test",
    "build:prod": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs prod",
    "build:cf": "npm run typecheck && npm run verify:images && node scripts/build-h5.mjs cf",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "npm run test:e2e:formal",
    "test:e2e:formal": "playwright test tests/e2e/formal-h5.spec.ts tests/e2e/uxe-exchange.spec.ts tests/e2e/redeem-code-project-selector.spec.ts tests/e2e/card-ticket-legacy-layout.spec.ts",
    "test:e2e:bridge-lab": "playwright test tests/e2e/bridge-lab.spec.ts",
    "test:e2e:test-gate": "playwright test tests/e2e/test-gate.spec.ts",
    "test:e2e:ui": "playwright test tests/e2e/formal-h5.spec.ts --ui",
    "report:evidence": "node scripts/build-test-evidence.mjs",
    "verify:t015": "npm run verify:legacy:t015",
    "verify:legacy:t015": "node scripts/verify-t015.mjs",
    "verify:t024": "node scripts/verify-t024.mjs",
    "verify:h007": "node scripts/verify-h007-http.mjs",
    "verify:h009": "node scripts/verify-h009-contracts.mjs",
    "verify:h010": "node scripts/verify-h010-state.mjs",
    "verify:h011": "node scripts/verify-h011-storage.mjs",
    "verify:h012": "node scripts/verify-h012-forms.mjs",
    "verify:h013": "node scripts/verify-h013-msw.mjs",
    "verify:h014": "node scripts/verify-h014-mock-scenarios.mjs",
    "verify:h015": "node scripts/verify-h015-jsbridge.mjs",
    "verify:h022": "node scripts/verify-h022-route-state-convergence.mjs",
    "verify:h023": "node scripts/verify-h023-shared-components.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "axios": "1.19.0",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "js-md5": "0.9.2",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.88.0",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eruda": "3.4.3",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
